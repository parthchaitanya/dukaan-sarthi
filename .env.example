# ---- AI for open-ended Ask Anything questions (optional) --------------------
# auto = Groq if GROQ_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set, else the offline engine
LLM_PROVIDER=auto

# Groq. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Good tool-calling models: llama-3.3-70b-versatile, openai/gpt-oss-120b, qwen/qwen3-32b
GROQ_MODEL=llama-3.3-70b-versatile

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Voice -------------------------------------------------------------------
# Groq's only voice model is English-only, so for clear Hindi/Hinglish use Sarvam AI (Indian voices).
# auto = Sarvam when SARVAM_API_KEY is set, else the clearest voice installed in the browser
TTS_PROVIDER=auto
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v4-flash
# Voices: shubh_enhi_ads (male, Hinglish), simran_enhi_customer (female, Hinglish), kavya_hi_conversational, ...
SARVAM_SPEAKER_HI=shubh_enhi_ads
SARVAM_SPEAKER_EN=shubh_en_narration
SARVAM_PACE=0.95

# Fixed demo date so the story is identical every time you present
DEMO_TODAY=2026-10-20

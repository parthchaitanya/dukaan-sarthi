# ---- AI for open-ended Ask Anything questions (optional) --------------------
# auto = Claude if ANTHROPIC_API_KEY is set, else Grok if XAI_API_KEY is set, else the offline engine
LLM_PROVIDER=auto

# Grok (xAI). Get a key at console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4.3
# Optional: none | low | medium | high (lower = faster answers)
GROK_REASONING_EFFORT=

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Voice -------------------------------------------------------------------
# auto = Grok's neural voice when XAI_API_KEY is set, else the browser's voice
TTS_PROVIDER=auto
# Try a few: eve, ara, naksh, leo, rex, sal ... (GET https://api.x.ai/v1/tts/voices lists all)
GROK_TTS_VOICE=eve
GROK_TTS_SPEED=0.95

# Fixed demo date so the story is identical every time you present
DEMO_TODAY=2026-10-20
